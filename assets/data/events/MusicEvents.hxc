package events;

import flixel.FlxG;

class MusicEvents extends Events
{

	override function defineEvents() {
		registerEvent({prefix: "muteInst", eventFunction: muteInst, ignoreOffset: true, editor: {description: MUTE_INST_DESC}});
		registerEvent({prefix: "playInst", eventFunction: playInst, ignoreOffset: true, editor: {description: PLAY_INST_DESC}});

		registerEvent({prefix: "muteVocals", eventFunction: muteVocals, ignoreOffset: true, editor: {description: MUTE_VOCALS_DESC, arguments: [
			{name: "Track", type: "vocalTrack", value: "all"}
		]}});
		registerEvent({prefix: "playVocals", eventFunction: playVocals, ignoreOffset: true, editor: {description: PLAY_VOCALS_DESC, arguments: [
			{name: "Track", type: "vocalTrack", value: "all"}
		]}});

		registerEvent({prefix: "toggleVocalVolumeLock", eventFunction: toggleVocalVolumeLock, ignoreOffset: true, editor: {description: TOGGLE_VOCAL_VOLUME_LOCK_DESC}});

		registerEvent({prefix: "playSound", eventFunction: playSound, ignoreOffset: true, editor: {description: PLAY_SOUND_DESC, arguments: [
			{name: "Sound Path", type: "string", value: ""}, {name: "Volume", type: "normalizedFloat", value: "1"}
		]}});
	}

	function muteInst(tag:String):Void{
		FlxG.sound.music.volume = 0;
	}

	function playInst(tag:String):Void{
		FlxG.sound.music.volume = 1;
	}

	function muteVocals(tag:String):Void{
		var args = Events.getArgs(tag);
		if(playstate.vocalType == splitVocalTrack){
			switch(args[0]){
				case "bf":
					playstate.vocals.volume = 0;
				case "dad":
					playstate.vocalsOther.volume = 0;
				default:
					playstate.vocals.volume = 0;
					playstate.vocalsOther.volume = 0;
			}
		}
		else{
			playstate.vocals.volume = 0;
		}
	}

	function playVocals(tag:String):Void{
		var args = Events.getArgs(tag);
		if(playstate.vocalType == splitVocalTrack){
			switch(args[0]){
				case "bf":
					playstate.vocals.volume = 1;
				case "dad":
					playstate.vocalsOther.volume = 1;
				default:
					playstate.vocals.volume = 1;
					playstate.vocalsOther.volume = 1;
			}
		}
		else{
			playstate.vocals.volume = 1;
		}
	}

	function toggleVocalVolumeLock(tag:String):Void{
		playstate.canChangeVocalVolume = !playstate.canChangeVocalVolume;
	}

	function playSound(tag:String):Void{
		var args = Events.getArgs(tag);
		playstate.playSound(Paths.sound(args[0]), Events.parseFloat(args[1]));
	}



	//Event descriptions. Not required but it helps with charting.
	final MUTE_INST_DESC:String = "Mutes the instrumental.";
	final PLAY_INST_DESC:String = "Plays the instrumental.";
	final PLAY_VOCALS_DESC:String = "Plays the vocals.";
	final MUTE_VOCALS_DESC:String = "Mutes the vocals.";
	final TOGGLE_VOCAL_VOLUME_LOCK_DESC:String = "Toggles whether hitting/missing notes will toggle the volume on the vocal tracks.";
	final PLAY_SOUND_DESC:String = "Plays a specified audio file.";
}