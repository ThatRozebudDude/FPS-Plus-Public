package events;

class HudEvents extends Events
{

	override function defineEvents() {
		registerEvent({prefix: "setHudSkin", eventFunction: setHudSkin, editor: {description: SET_HUD_SKIN_DESC, arguments: [
			{name: "Skin", type: "string", value: "Default"}
		]}});
		registerEvent({prefix: "hudVisible", eventFunction: hudVisible, editor: {description: HUD_VISIBLE_DESC, arguments: [
			{name: "Visible", type: "bool", value: "true"}
		]}});
		registerEvent({prefix: "showSongMeta", eventFunction: showSongMeta, editor: {description: SHOW_SONG_META_DESC}});
		registerEvent({prefix: "swapNoteSides", eventFunction: swapNoteSides, editor: {description: SWAP_NOTE_SIDES_DESC, arguments: [
			{name: "Time", type: "time", value: "1b"}, {name: "Ease", type: "ease", value: "quartOut"}
		]}});
		registerEvent({prefix: "scrollSpeedMultiplier", eventFunction: scrollSpeedMultiplier, editor: {description: SCROLL_SPEED_MULTIPLIER_DESC, arguments: [
			{name: "Multiplier", type: "float", value: "1"}, {name: "Time", type: "time", value: "0"}, {name: "Ease", type: "ease", value: "quartOut"}
		]}});
	}

	function setHudSkin(tag:String):Void{
		var args = Events.getArgs(tag);
		playstate.regenerateUiSkin(args[0]);
	}

	function hudVisible(tag:String):Void{
		var args = Events.getArgs(tag);
		playstate.camHUD.visible = Events.parseBool(args[0]);
	}
	
	function showSongMeta(tag:String):Void{
		if(playstate.meta != null){ playstate.meta.start(); }
	}
	
	function swapNoteSides(tag:String):Void{
		if(Config.centeredNotes || playstate.forceCenteredNotes){ return; } //Don't swap notes if there aren't notes to swap with.
		
		var args = Events.getArgs(tag);
		var playerNotePositions = [];
		var opponentNotePositions = [];

		for(arrow in playstate.playerStrums.members){
			tween.completeTweensOf(arrow);
			playerNotePositions.push([arrow.x, arrow.y]);
		}
		for(arrow in playstate.enemyStrums.members){
			tween.completeTweensOf(arrow);
			opponentNotePositions.push([arrow.x, arrow.y]);
		}

		for(arrow in playstate.playerStrums.members){
			if(Events.parseTime(args[0]) > 0){
				tween.tween(arrow, {x: opponentNotePositions[arrow.ID][0], y: opponentNotePositions[arrow.ID][1]}, Events.parseTime(args[0]), {ease: Events.parseEase(args[1])});
			}
			else{
				arrow.x = opponentNotePositions[arrow.ID][0];
				arrow.y = opponentNotePositions[arrow.ID][1];
			}
		}
		for(arrow in playstate.enemyStrums.members){
			if(Events.parseTime(args[0]) > 0){
				tween.tween(arrow, {x: playerNotePositions[arrow.ID][0], y: playerNotePositions[arrow.ID][1]}, Events.parseTime(args[0]), {ease: Events.parseEase(args[1])});
			}
			else{
				arrow.x = playerNotePositions[arrow.ID][0];
				arrow.y = playerNotePositions[arrow.ID][1];
			}
		}
	}

	function scrollSpeedMultiplier(tag:String):Void{
		var args = Events.getArgs(tag, ["1", "0", "linear"]);
		var time = Events.parseTime(args[1]);

		if(time > 0){
			tween.tween(playstate, {scrollSpeedMultiplier: Events.parseFloat(args[0])}, time, {ease: Events.parseEase(args[3])});
		}
		else{
			playstate.scrollSpeedMultiplier = Events.parseFloat(args[0]);
		}
	}
	


	//Event descriptions. Not required but it helps with charting.
	final SET_HUD_SKIN_DESC:String = "Changes the HUD note skin.";
	final HUD_VISIBLE_DESC:String = "Sets the visibility of the HUD.";
	final SHOW_SONG_META_DESC:String = "Shows the song name and artist.";
	final SWAP_NOTE_SIDES_DESC:String = "Swaps player and opponent note sides. Does nothing if the strumline is centered.";
	final SCROLL_SPEED_MULTIPLIER_DESC:String = "Adjusts the modifier for the note scroll speed.";
}