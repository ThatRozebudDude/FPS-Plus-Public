package notetypes;

import flixel.tweens.FlxEase;
import flixel.FlxG;

class AnimationNotes extends NoteType
{

	override function defineTypes():Void{
		registerNoteType({prefix: "playAnim", noteHit: playAnimHit, noteMiss: playAnimMiss, sustainHit: playAnimSustainHit, sustainMiss: playAnimSustainMiss, editor: {description: PLAY_ANIM_DESC, arguments: [
			{name: "Hit Animation", type: "string", value: ""}, {name: "Miss Animation", type: "string", value: ""}, {name: "Dynamic Camera Movement", type: "bool", value: "true"}
		]}});

		registerNoteType({prefix: "noAnim", noteHit: noAnimationHit, noteMiss: noAnimationHit, sustainHit: noAnimationSustainHit, sustainMiss: noAnimationSustainHit, editor: {description: PLAY_ANIM_DESC, arguments: [
			{name: "Dynamic Camera Movement", type: "bool", value: "true"}
		]}});

		registerNoteType({prefix: "animSet", noteHit: animSetHit, noteMiss: animSetMiss, sustainHit: animSetSustainHit, sustainMiss: animSetSustainMiss, editor: {description: ANIM_SET_DESC, arguments: [
			{name: "Animation Set", type: "string", value: ""}
		]}});
	}



	function playAnimHit(note:Note, character:Character){
		var args = NoteType.getArgs(note.type);
		if(character.canAutoAnim){
			if(shouldPlayAnimation(note, character)){
				if(args[0] != ""){ character.singAnim(args[0], true); }
				else{ playstate.defaultNoteHit(note, character); }
			}
			character.holdTimer = 0;
		}
		if(Events.parseBool(args[2])){
			playstate.getExtraCamMovement(note);
		}
	}

	function playAnimSustainHit(note:NoteSustain, character:Character){
		var args = NoteType.getArgs(note.type);
		if(character.canAutoAnim){
			if(shouldPlayAnimation(note, character)){
				if(args[0] != ""){ character.singAnim(args[0], true); }
				else{ playstate.defaultSustainHit(note, character); }
			}
			character.holdTimer = 0;
		}
	}

	function playAnimMiss(note:Note, character:Character){
		var args = NoteType.getArgs(note.type);
		if(character.canAutoAnim){
			if(args[1] != ""){ character.singAnim(args[1], true); }
			else{ playstate.defaultNoteMiss(note, character); }
		}
	}

	function playAnimSustainMiss(note:NoteSustain, character:Character){
		var args = NoteType.getArgs(note.type);
		if(character.canAutoAnim){
			if(args[1] != ""){ character.singAnim(args[1], true); }
			else{ playstate.defaultSustainMiss(note, character); }
		}
	}



	function noAnimationHit(note:Note, character:Character){
		var args = NoteType.getArgs(note.type);
		if(character.canAutoAnim){
			character.holdTimer = 0;
		}
		if(Events.parseBool(args[0])){
			playstate.getExtraCamMovement(note);
		}
	}

	function noAnimationSustainHit(note:NoteSustain, character:Character){
		var args = NoteType.getArgs(note.type);
		if(character.canAutoAnim){
			character.holdTimer = 0;
		}
	}



	function animSetHit(note:Note, character:Character){
		var args = NoteType.getArgs(note.type);
		var prevAnimSet = character.animSet;
		character.animSet = args[0];
		playstate.defaultNoteHit(note, character);
		character.animSet = prevAnimSet;
	}

	function animSetSustainHit(note:NoteSustain, character:Character){
		var args = NoteType.getArgs(note.type);
		var prevAnimSet = character.animSet;
		character.animSet = args[0];
		playstate.defaultSustainHit(note, character);
		character.animSet = prevAnimSet;
	}

	function animSetMiss(note:Note, character:Character){
		var args = NoteType.getArgs(note.type);
		var prevAnimSet = character.animSet;
		character.animSet = args[0];
		playstate.defaultNoteMiss(note, character);
		character.animSet = prevAnimSet;
	}

	function animSetSustainMiss(note:NoteSustain, character:Character){
		var args = NoteType.getArgs(note.type);
		var prevAnimSet = character.animSet;
		character.animSet = args[0];
		playstate.defaultSustainMiss(note, character);
		character.animSet = prevAnimSet;
	}



	final PLAY_ANIM_DESC:String = "Plays the specified animation instead of the normal directional sing animation.";
	final NO_ANIM_DESC:String = "Does not play any animation.";
	final ANIM_SET_DESC:String = "Sets the character's animation set for this note only. ";
	
}