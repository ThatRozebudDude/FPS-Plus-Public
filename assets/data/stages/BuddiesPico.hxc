package stages;

import flixel.tweens.FlxTween;
import flixel.math.FlxPoint;
import flixel.FlxObject;

class BuddiesPico extends BaseStage
{

	var chartBlackBG:FlxSprite;

	public function new(){
		super();

		name = "buddiesPico";
		startingZoom = 2.8;

		var lilStage = new FlxSprite(0, -34).loadGraphic(Paths.image("fpsPlus/buddies/lilStageP"));
		lilStage.antialiasing = false;
		addToBackground(lilStage);

		gf.visible = false;
		boyfriend.setPosition(0, -34);
		dad.setPosition(20, -28);

		useStartPoints = false;

		cameraMovementEnabled = false;
		extraCameraMovementAmount = 4;

		cameraStartPosition = new FlxPoint(256/2, 256/2);

	}

}