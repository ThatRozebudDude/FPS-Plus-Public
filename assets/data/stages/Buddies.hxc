package stages;

import flixel.tweens.FlxTween;
import flixel.math.FlxPoint;
import flixel.FlxObject;

class Buddies extends BaseStage
{

	var chartBlackBG:FlxSprite;

	public function new(){
		super();
		
		name = "buddies";
		startingZoom = 2.8;

		var lilStage = new FlxSprite(32, 432).loadGraphic(Paths.image("fpsPlus/buddies/lilStage"));
		lilStage.antialiasing = false;
		addToBackground(lilStage);

		gf.visible = false;
		boyfriend.setPosition(32, 432);
		dad.setPosition(32, 432);

		useStartPoints = false;

		cameraMovementEnabled = false;
		extraCameraMovementAmount = 4;

		cameraStartPosition = new FlxPoint(155, 600);

	}

}